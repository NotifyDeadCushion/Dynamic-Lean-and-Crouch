-- Dynamic Lean and Crouch
-- Version: V1.210
-- Author: Boeker

lean_value_l = 1 	-- global: dlac_monkey_patches.script reads these directly
lean_value_r = 1	-- global: dlac_monkey_patches.script reads these directly

-- ----------------------------------------------------------------------------
-- CONFIG
-- ----------------------------------------------------------------------------
local CONFIG = {
	CROUCH_FROM_NOTHING_DEADBAND = 0.005,   		-- min push needed to start crouching from standing (mouse only)
	CROUCH_KEYBIND_BASE          = 0.005,   		-- crouch offset per keybind tick, at sensitivity factor 5 (middle)
	CROUCH_MOUSE_MOVE_BASE       = 0.00025, 		-- crouch offset per pixel, at sensitivity factor 1
	LEAN_FROM_NOTHING_DEADBAND   = 3,       		-- min mouse pixels needed to start a lean from neutral
	LEAN_KEYBIND_BASE            = 0.05,    		-- lean coefficient per keybind tick, at sensitivity factor 5 (middle)
	LEAN_MOUSE_MOVE_BASE         = 0.0025,  		-- lean coefficient per pixel, at sensitivity factor 1
	MAX_CROUCH                   = 0.25,    		-- crouch offset at the standing/crouch boundary
	MAX_LEAN                     = 2,       		-- maximum lean coefficient
	MIN_CROUCH                   = -0.35,   		-- crouch offset at the crouch/prone boundary
	MIN_LEAN                     = 0,       		-- minimum lean coefficient (fully upright)
	STANCE_LOCK_MS               = 350,     		-- lockout after any stance change, lets the animation finish
	STANCE_TRANSITION_OVERSHOOT_BASE = 0.02, 		-- prone commit threshold at factor 1; standing is half of this
	STANCE_TRANSITION_STANDING_RATIO = 0.5,  		-- standing's threshold = base * this ratio
}

control_modes = { keybind = 1, mouse_move = 0 } 	-- global: dlac_monkey_patches.script reads this

-- ----------------------------------------------------------------------------
-- KEYS
-- ----------------------------------------------------------------------------
-- Resolved on actor_on_first_update, not here -- the player's real
-- keybinds may not be loaded yet at script-load time.
local KEYS = {}

-- ----------------------------------------------------------------------------
-- STATE -- alphabetical
-- ----------------------------------------------------------------------------
local STATE = {
	adjustment_key                 = DIK_keys.DIK_LMENU, 			-- held to enable dynamic lean/crouch control
	crouch_enabled                 = true,  						-- master on/off for dynamic crouch control
	crouch_from_nothing            = true,  						-- lets crouch start from standing via mouse alone
	crouch_keybind_down            = DIK_keys.DIK_S, 				-- keybind-mode nudge key, crouch lower
	crouch_keybind_step            = CONFIG.CROUCH_KEYBIND_BASE, 	-- crouch offset per keybind tick, scaled by sensitivity
	crouch_keybind_up              = DIK_keys.DIK_W, 				-- keybind-mode nudge key, crouch higher
	crouch_offset                  = 0,    							-- current crouch depth, CONFIG.MIN_CROUCH..CONFIG.MAX_CROUCH
	crouch_target                  = nil,   						-- pending animation target for the normal crouch key's reset
	default_reset_timer            = 0,     						-- 0 = remember last depth/angle instead of resetting
	dynamically_switch_sides       = true,  						-- lets a lean flip to the other side past the limit
	dynamically_switch_stances     = true,  						-- lets crouch flow into prone/standing past the limit
	lean_enabled                   = true,  						-- master on/off for dynamic lean control
	lean_from_nothing              = true,  						-- lets a lean start from neutral via mouse alone
	lean_keybind_left              = DIK_keys.DIK_A, 				-- keybind-mode nudge key, lean further left
	lean_keybind_right             = DIK_keys.DIK_D, 				-- keybind-mode nudge key, lean further right
	lean_keybind_step              = CONFIG.LEAN_KEYBIND_BASE, 		-- lean coefficient per keybind tick, scaled by sensitivity
	lean_side                      = nil,   						-- nil | "l" | "r"
	lean_target_l                  = nil,   						-- pending animation target for the normal lean key's reset (left)
	lean_target_r                  = nil,   						-- pending animation target for the normal lean key's reset (right)
	mod_enabled                    = true,  						-- master on/off for the whole mod
	mode_crouch                    = control_modes.mouse_move, 		-- current crouch adjustment mode
	mode_lean                      = control_modes.mouse_move, 		-- current lean adjustment mode
	mouse_coef_crouch              = CONFIG.CROUCH_MOUSE_MOVE_BASE, -- crouch offset per pixel, scaled by sensitivity
	mouse_coef_lean                = CONFIG.LEAN_MOUSE_MOVE_BASE, 	-- lean coefficient per pixel, scaled by sensitivity
	sprint_removes_stance_and_lean = true,  						-- sprinting stands you up and drops any lean
	stance                         = "standing", 					-- "standing" | "crouching" | "prone"
	stance_lock_until              = 0,     						-- timestamp; no crouch adjustment until this passes
	stance_overshoot               = 0,     						-- accumulated push past a boundary, toward committing to a new stance

	stance_transition_overshoot_prone    = CONFIG.STANCE_TRANSITION_OVERSHOOT_BASE, 											-- push needed to commit to prone
	stance_transition_overshoot_standing = CONFIG.STANCE_TRANSITION_OVERSHOOT_BASE * CONFIG.STANCE_TRANSITION_STANDING_RATIO, 	-- push needed to commit to standing
}

-- ----------------------------------------------------------------------------
-- Forward declarations, so implementations below can be alphabetical
-- regardless of which functions call which.
-- ----------------------------------------------------------------------------
local apply_crouch_delta, apply_lean_delta, begin_crouch_reset, begin_lean_reset,
      compute_axis_weights, dispatch_lean_input, full_reset, get_lean_magnitude,
      handle_crouch_key_press, handle_lean_key_press, handle_sprint_key_press,
      lean_key_for, refresh_keys, release_lean_to_neutral, reset_crouch_to_neutral,
      set_crouch_engaged, set_crouch_value, set_lean_engaged, set_lean_magnitude,
      set_lean_value, step_toward, try_enter_crouch, try_enter_prone, try_exit_prone,
      try_exit_to_standing

-- ----------------------------------------------------------------------------
-- Implementations, alphabetical
-- ----------------------------------------------------------------------------

-- bypass_deadband: keybind/scroll nudges are already deliberate, unlike
-- mouse jitter, so they skip the From Nothing deadband.
apply_crouch_delta = function(delta, bypass_deadband)
	if time_global() < STATE.stance_lock_until then return end

	if STATE.stance == "prone" then
		if delta > 0 and STATE.dynamically_switch_stances then
			try_exit_prone(delta)
		else
			STATE.stance_overshoot = 0
		end
		return
	end

	if STATE.stance == "standing" then
		local clears_deadband = bypass_deadband or (delta < -CONFIG.CROUCH_FROM_NOTHING_DEADBAND)
		if delta < 0 and clears_deadband and STATE.crouch_from_nothing then
			try_enter_crouch()
		end
		return
	end

	-- crouching: in-range adjustment always works, boundaries need the toggle
	local raw_value = STATE.crouch_offset + delta

	if raw_value >= CONFIG.MAX_CROUCH then
		if STATE.dynamically_switch_stances then
			try_exit_to_standing(raw_value)
		else
			STATE.crouch_offset = CONFIG.MAX_CROUCH
			set_crouch_value(CONFIG.MAX_CROUCH)
		end
		return
	end

	if raw_value <= CONFIG.MIN_CROUCH then
		if STATE.dynamically_switch_stances then
			try_enter_prone(raw_value)
		else
			STATE.crouch_offset = CONFIG.MIN_CROUCH
			set_crouch_value(CONFIG.MIN_CROUCH)
		end
		return
	end

	STATE.stance_overshoot = 0
	STATE.crouch_offset = raw_value
	set_crouch_value(raw_value)
end

-- Adjusts one side's lean magnitude. starting_fresh engages the engine
-- action for a brand new lean; otherwise just applies delta to the side
-- already active.
apply_lean_delta = function(side, delta, starting_fresh)
	if starting_fresh then
		set_lean_engaged(lean_key_for(side), true)
		STATE.lean_side = side
		set_lean_magnitude(side, 0)
	end

	local new_value = get_lean_magnitude(side) + delta

	if new_value <= CONFIG.MIN_LEAN and STATE.dynamically_switch_sides then
		local overflow = CONFIG.MIN_LEAN - new_value
		local other_side = (side == "l") and "r" or "l"

		set_lean_engaged(lean_key_for(side), false)
		set_lean_engaged(lean_key_for(other_side), true)
		STATE.lean_side = other_side

		set_lean_magnitude(side, CONFIG.MIN_LEAN)
		set_lean_magnitude(other_side, clamp(CONFIG.MIN_LEAN + overflow, CONFIG.MIN_LEAN, CONFIG.MAX_LEAN))
		set_lean_value(get_lean_magnitude(other_side))
		return
	end

	new_value = clamp(new_value, CONFIG.MIN_LEAN, CONFIG.MAX_LEAN)
	set_lean_magnitude(side, new_value)
	set_lean_value(new_value)
end

-- Queues the normal crouch key's reset to the default depth, if resetting
-- is enabled in MCM.
begin_crouch_reset = function()
	if STATE.default_reset_timer <= 0 then return end
	STATE.crouch_target = 0
end

-- Side-switch carryover always calls this; a fresh engage only calls it
-- when resetting is enabled (see handle_lean_key_press).
begin_lean_reset = function(side, target)
	if STATE.default_reset_timer > 0 then
		if side == "l" then STATE.lean_target_l = target else STATE.lean_target_r = target end
	else
		set_lean_magnitude(side, target)
		set_lean_value(target)
	end
end

-- Splits mouse movement into lean vs crouch weight, so a diagonal drag can
-- adjust both, but drift off either axis doesn't leak into the other.
compute_axis_weights = function(dx, dy)
	local ax, ay = math.abs(dx), math.abs(dy)
	local total = ax + ay
	if total <= 0 then return 0, 0 end

	local horizontal_ratio = ax / total
	local lean_weight = clamp(2 * horizontal_ratio, 0, 1)
	local stance_weight = clamp(2 * (1 - horizontal_ratio), 0, 1)
	return lean_weight, stance_weight
end

-- Routes lean input from any mode (mouse or keybind) through the same
-- engage/adjust/switch logic, so both feel identical.
dispatch_lean_input = function(desired_side, magnitude)
	if STATE.lean_side == "l" then
		apply_lean_delta("l", (desired_side == "l") and magnitude or -magnitude)
	elseif STATE.lean_side == "r" then
		apply_lean_delta("r", (desired_side == "r") and magnitude or -magnitude)
	elseif STATE.lean_from_nothing then
		apply_lean_delta(desired_side, magnitude, true)
	end
end

-- Returns lean and crouch to neutral. Runs when the mod itself is disabled.
full_reset = function()
	release_lean_to_neutral()
	reset_crouch_to_neutral()
end

get_lean_magnitude = function(side)
	if side == "l" then return lean_value_l else return lean_value_r end
end

-- Real crouch key: toggles between standing and crouching.
handle_crouch_key_press = function()
	if STATE.stance == "standing" then
		STATE.stance = "crouching"
		STATE.stance_overshoot = 0
		begin_crouch_reset()
	else
		STATE.stance = "standing"
		STATE.crouch_target = nil
	end
end

-- Real lean key: toggles the given side on/off. Switching from the other
-- side carries its magnitude over instead of resetting.
handle_lean_key_press = function(side)
	local was_active = (STATE.lean_side == side)
	local was_neutral = (STATE.lean_side == nil)
	local previous_side = STATE.lean_side

	if was_active then
		STATE.lean_side = nil
		return
	end

	STATE.lean_side = side

	if not was_neutral then
		local target = get_lean_magnitude(previous_side)
		set_lean_magnitude(side, target)
		begin_lean_reset(side, target)
	elseif STATE.default_reset_timer > 0 then
		begin_lean_reset(side, 1)
	end
end

-- Vanilla blocks sprint while leaning instead of cancelling it, so lean
-- needs releasing here. Crouch/prone are already cancelled by vanilla.
handle_sprint_key_press = function()
	release_lean_to_neutral()

	STATE.stance = "standing"
	STATE.crouch_offset = 0
	STATE.crouch_target = nil
	STATE.stance_overshoot = 0
end

lean_key_for = function(side)
	return side == "l" and KEYS.lean_left or KEYS.lean_right
end

-- Reads the player's actual crouch/lean/sprint/accel keybinds.
refresh_keys = function()
	KEYS.accel = bind_to_dik(key_bindings.kACCEL) -- crouch + accel = prone
	KEYS.crouch = bind_to_dik(key_bindings.kCROUCH)
	KEYS.lean_left = bind_to_dik(key_bindings.kL_LOOKOUT)
	KEYS.lean_right = bind_to_dik(key_bindings.kR_LOOKOUT)
	KEYS.sprint = bind_to_dik(key_bindings.kSPRINT_TOGGLE)
end

-- Disengages any active lean and resets magnitude to default.
release_lean_to_neutral = function()
	if STATE.lean_side then
		set_lean_engaged(lean_key_for(STATE.lean_side), false)
		STATE.lean_side = nil
	end
	lean_value_l, lean_value_r = 1, 1
	set_lean_value(1)
	STATE.lean_target_l, STATE.lean_target_r = nil, nil
end

-- Returns to standing from crouch or prone, and resets the depth offset.
reset_crouch_to_neutral = function()
	if STATE.stance == "prone" then
		level.press_action(KEYS.accel)
	end

	if STATE.stance ~= "standing" then
		STATE.crouch_offset = 0
		set_crouch_value(0)
		set_crouch_engaged(false)
	end

	STATE.stance = "standing"
	STATE.stance_overshoot = 0
	STATE.crouch_target = nil
end

-- Engages or releases crouch, respecting hold vs toggle crouch config.
set_crouch_engaged = function(engaged)
	if get_console_cmd(1, "g_crouch_toggle") then
		level.press_action(KEYS.crouch)
	else
		if engaged then level.hold_action(KEYS.crouch) else level.release_action(KEYS.crouch) end
	end
end

set_crouch_value = function(value)
	db.actor:set_actor_box_y_offset(1, value)
end

-- Engages or releases a lean side, respecting hold vs toggle lean config.
set_lean_engaged = function(dik, engaged)
	if get_console_cmd(1, "g_lookout_toggle") then
		level.press_action(dik)
	else
		if engaged then level.hold_action(dik) else level.release_action(dik) end
	end
end

set_lean_magnitude = function(side, value)
	if side == "l" then lean_value_l = value else lean_value_r = value end
end

set_lean_value = function(value)
	db.actor:set_actor_lookout_coef(value)
end

-- Eases current toward target at a rate based on the reset timer. Returns
-- target exactly once close enough, so equality checks stay float-safe.
step_toward = function(current, target, dt, range)
	if STATE.default_reset_timer <= 0 then return target end

	local rate = range / STATE.default_reset_timer
	local diff = target - current
	local move = rate * dt
	if math.abs(diff) <= move then return target end
	return current + (diff > 0 and move or -move)
end

-- Standing to crouching.
try_enter_crouch = function()
	set_crouch_engaged(true)
	STATE.stance = "crouching"
	STATE.stance_lock_until = time_global() + CONFIG.STANCE_LOCK_MS
	STATE.stance_overshoot = 0
	STATE.crouch_offset = 0
	set_crouch_value(0)
end

-- Requires sustained push, not just a touch, so a fast swipe can't blow
-- through the whole crouch range in one tick.
try_enter_prone = function(raw_value)
	STATE.stance_overshoot = STATE.stance_overshoot + (CONFIG.MIN_CROUCH - raw_value)

	if STATE.stance_overshoot < STATE.stance_transition_overshoot_prone then
		STATE.crouch_offset = CONFIG.MIN_CROUCH
		set_crouch_value(CONFIG.MIN_CROUCH)
		return
	end

	level.press_action(KEYS.accel)
	STATE.stance = "prone"
	STATE.stance_lock_until = time_global() + CONFIG.STANCE_LOCK_MS
	STATE.stance_overshoot = 0
	STATE.crouch_offset = CONFIG.MIN_CROUCH
	set_crouch_value(CONFIG.MIN_CROUCH)
end

-- Prone to crouching. Same overshoot rule as entering prone.
try_exit_prone = function(delta)
	STATE.stance_overshoot = STATE.stance_overshoot + delta
	if STATE.stance_overshoot < STATE.stance_transition_overshoot_prone then return end

	level.press_action(KEYS.accel)
	STATE.stance = "crouching"
	STATE.stance_lock_until = time_global() + CONFIG.STANCE_LOCK_MS
	STATE.stance_overshoot = 0
	STATE.crouch_offset = 0
	set_crouch_value(0)
end

-- Crouching to standing. Same overshoot rule as entering prone.
try_exit_to_standing = function(raw_value)
	STATE.stance_overshoot = STATE.stance_overshoot + (raw_value - CONFIG.MAX_CROUCH)

	if STATE.stance_overshoot < STATE.stance_transition_overshoot_standing then
		STATE.crouch_offset = CONFIG.MAX_CROUCH
		set_crouch_value(CONFIG.MAX_CROUCH)
		return
	end

	set_crouch_engaged(false)
	STATE.stance = "standing"
	STATE.stance_lock_until = time_global() + CONFIG.STANCE_LOCK_MS
	STATE.stance_overshoot = 0
	STATE.crouch_offset = CONFIG.MAX_CROUCH
end

-- ----------------------------------------------------------------------------
-- Engine callbacks
-- ----------------------------------------------------------------------------

-- Keybind-mode nudge input for lean and crouch.
function on_before_key_hold(key, bind, dis, flags)
	if not STATE.mod_enabled then return end
	if STATE.mode_lean ~= control_modes.keybind and STATE.mode_crouch ~= control_modes.keybind then return end

	if STATE.lean_enabled and (key == STATE.lean_keybind_left or key == STATE.lean_keybind_right)
		and key_state(STATE.adjustment_key) == 1 and STATE.mode_lean == control_modes.keybind then
		local desired_side = (key_state(STATE.lean_keybind_left) == 1 and "l")
			or (key_state(STATE.lean_keybind_right) == 1 and "r") or nil
		if desired_side then
			dispatch_lean_input(desired_side, STATE.lean_keybind_step)
		end
		flags.ret_value = false
	end

	if STATE.crouch_enabled and (key == STATE.crouch_keybind_up or key == STATE.crouch_keybind_down)
		and key_state(STATE.adjustment_key) == 1 and STATE.mode_crouch == control_modes.keybind then
		flags.ret_value = false

		if STATE.stance ~= "standing" or STATE.crouch_from_nothing then
			local polarity = (key_state(STATE.crouch_keybind_up) == 1 and 1)
				or (key_state(STATE.crouch_keybind_down) == 1 and -1) or 0
			apply_crouch_delta(STATE.crouch_keybind_step * polarity, true)
		end
	end
end

-- Mouse-driven lean and crouch adjustment while the adjustment key is held.
function on_before_mouse_move(dx, dy, inputs_disabled, flags)
	if not STATE.mod_enabled then return end
	if STATE.mode_lean ~= control_modes.mouse_move and STATE.mode_crouch ~= control_modes.mouse_move then return end

	local move_left, move_right = (dx < 0), (dx > 0)
	local move_up, move_down = (dy < 0), (dy > 0)
	local x_strength, y_strength = math.abs(dx), math.abs(dy)
	local lean_weight, stance_weight = compute_axis_weights(dx, dy)

	if STATE.lean_enabled and key_state(STATE.adjustment_key) == 1 and STATE.mode_lean == control_modes.mouse_move then
		flags.ret_value = true

		local magnitude = STATE.mouse_coef_lean * x_strength * lean_weight
		local desired_side = (move_right and "r") or (move_left and "l") or nil

		if desired_side then
			local can_start_fresh = STATE.lean_from_nothing and x_strength > CONFIG.LEAN_FROM_NOTHING_DEADBAND
			if STATE.lean_side or can_start_fresh then
				dispatch_lean_input(desired_side, magnitude)
			end
		end
	end

	if STATE.crouch_enabled and key_state(STATE.adjustment_key) == 1 and STATE.mode_crouch == control_modes.mouse_move then
		flags.ret_value = true

		if STATE.stance ~= "standing" or STATE.crouch_from_nothing then
			local change = STATE.mouse_coef_crouch * y_strength * stance_weight
			change = (move_down and -change) or (move_up and change) or 0
			apply_crouch_delta(change)
		end
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_update", on_update)

	RegisterScriptCallback("on_before_mouse_move", on_before_mouse_move)
	RegisterScriptCallback("on_before_key_hold", on_before_key_hold)

	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("on_key_release", on_key_release)

	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", on_option_change)
end

-- Real key presses for crouch, sprint, and lean.
function on_key_press(key)
	if not STATE.mod_enabled then return end

	if STATE.crouch_enabled then
		if key == KEYS.crouch then handle_crouch_key_press() end
	end
	if key == KEYS.sprint and STATE.sprint_removes_stance_and_lean then handle_sprint_key_press() end

	if STATE.lean_enabled then
		if key == KEYS.lean_left then handle_lean_key_press("l")
		elseif key == KEYS.lean_right then handle_lean_key_press("r") end
	end
end

-- Hold mode only. Real key release syncs tracking with what vanilla
-- already stopped; adjustment-key release resets a mouse/keybind-driven
-- lean, since no real key exists for vanilla to have released there.
function on_key_release(key)
	if not STATE.mod_enabled then return end
	if not STATE.lean_enabled then return end
	if get_console_cmd(1, "g_lookout_toggle") then return end

	if key == STATE.adjustment_key then
		if STATE.lean_side then release_lean_to_neutral() end
		return
	end

	if key == KEYS.lean_left and STATE.lean_side == "l" then
		STATE.lean_side = nil
	elseif key == KEYS.lean_right and STATE.lean_side == "r" then
		STATE.lean_side = nil
	end
end

-- Reads every MCM setting into STATE. Runs at game start and whenever any
-- MCM option is applied.
function on_option_change()
	refresh_keys()

	local root = "dlac/"

	STATE.adjustment_key = ui_mcm.get(root .. "general_dlac/adjustment_keybind") or DIK_keys.DIK_LMENU

	local new_crouch_enabled = ui_mcm.get(root .. "crouch_dlac/crouch_enabled")
	if new_crouch_enabled == nil then new_crouch_enabled = true end
	if STATE.crouch_enabled and not new_crouch_enabled then reset_crouch_to_neutral() end
	STATE.crouch_enabled = new_crouch_enabled

	STATE.crouch_from_nothing = ui_mcm.get(root .. "crouch_dlac/crouch_from_nothing")
	STATE.crouch_keybind_down = ui_mcm.get(root .. "crouch_dlac/adjustment_keybind_down")
	STATE.crouch_keybind_step = CONFIG.CROUCH_KEYBIND_BASE
		* ((ui_mcm.get(root .. "crouch_dlac/keybind_sensitivity_factor") or 5) / 5)
	STATE.crouch_keybind_up = ui_mcm.get(root .. "crouch_dlac/adjustment_keybind_up")
	STATE.default_reset_timer = ui_mcm.get(root .. "general_dlac/default_reset_timer") or 0
	STATE.dynamically_switch_sides = ui_mcm.get(root .. "lean_dlac/dynamically_switch_sides")
	STATE.dynamically_switch_stances = ui_mcm.get(root .. "crouch_dlac/dynamically_switch_stances")

	local new_lean_enabled = ui_mcm.get(root .. "lean_dlac/lean_enabled")
	if new_lean_enabled == nil then new_lean_enabled = true end
	if STATE.lean_enabled and not new_lean_enabled then release_lean_to_neutral() end
	STATE.lean_enabled = new_lean_enabled

	STATE.lean_from_nothing = ui_mcm.get(root .. "lean_dlac/lean_from_nothing")
	STATE.lean_keybind_left = ui_mcm.get(root .. "lean_dlac/adjustment_keybind_left")
	STATE.lean_keybind_right = ui_mcm.get(root .. "lean_dlac/adjustment_keybind_right")
	STATE.lean_keybind_step = CONFIG.LEAN_KEYBIND_BASE
		* ((ui_mcm.get(root .. "lean_dlac/keybind_sensitivity_factor") or 5) / 5)

	local new_mod_enabled = ui_mcm.get(root .. "general_dlac/mod_enabled")
	if new_mod_enabled == nil then new_mod_enabled = true end
	if STATE.mod_enabled and not new_mod_enabled then full_reset() end
	STATE.mod_enabled = new_mod_enabled

	STATE.mode_crouch = control_modes[ui_mcm.get(root .. "crouch_dlac/adjustment_mode")] or control_modes.mouse_move
	STATE.mode_lean = control_modes[ui_mcm.get(root .. "lean_dlac/adjustment_mode")] or control_modes.mouse_move

	STATE.mouse_coef_crouch = CONFIG.CROUCH_MOUSE_MOVE_BASE
		* (ui_mcm.get(root .. "crouch_dlac/mouse_sensitivity_factor") or 1)
	STATE.mouse_coef_lean = CONFIG.LEAN_MOUSE_MOVE_BASE
		* (ui_mcm.get(root .. "lean_dlac/mouse_sensitivity_factor") or 1)

	local sras = ui_mcm.get(root .. "general_dlac/sprint_removes_stance_and_lean")
	if sras == nil then sras = true end
	STATE.sprint_removes_stance_and_lean = sras

	local stance_commit_factor = ui_mcm.get(root .. "crouch_dlac/stance_commit_factor") or 1
	STATE.stance_transition_overshoot_prone = CONFIG.STANCE_TRANSITION_OVERSHOOT_BASE * stance_commit_factor
	STATE.stance_transition_overshoot_standing = CONFIG.STANCE_TRANSITION_OVERSHOOT_BASE
		* CONFIG.STANCE_TRANSITION_STANDING_RATIO * stance_commit_factor
end

local last_update_time = time_global()
-- Per-frame: reasserts hold-mode lean, and eases any pending reset
-- animations toward their target.
function on_update()
	local now = time_global()
	local dt = (now - last_update_time) / 1000
	last_update_time = now

	if not STATE.mod_enabled then return end

	-- Hold mode only -- hold_action needs continuous reassertion to stick.
	-- Never run this in toggle mode, or press_action would flip it every frame.
	if not get_console_cmd(1, "g_lookout_toggle") and STATE.lean_side then
		level.hold_action(lean_key_for(STATE.lean_side))
	end

	if STATE.lean_target_l then
		if STATE.lean_side == "l" then
			lean_value_l = step_toward(lean_value_l, STATE.lean_target_l, dt, CONFIG.MAX_LEAN - CONFIG.MIN_LEAN)
			set_lean_value(lean_value_l)
			if lean_value_l == STATE.lean_target_l then STATE.lean_target_l = nil end
		else
			STATE.lean_target_l = nil
		end
	end

	if STATE.lean_target_r then
		if STATE.lean_side == "r" then
			lean_value_r = step_toward(lean_value_r, STATE.lean_target_r, dt, CONFIG.MAX_LEAN - CONFIG.MIN_LEAN)
			set_lean_value(lean_value_r)
			if lean_value_r == STATE.lean_target_r then STATE.lean_target_r = nil end
		else
			STATE.lean_target_r = nil
		end
	end

	if STATE.crouch_target then
		STATE.crouch_offset = step_toward(STATE.crouch_offset, STATE.crouch_target, dt, CONFIG.MAX_CROUCH - CONFIG.MIN_CROUCH)
		set_crouch_value(STATE.crouch_offset)
		if STATE.crouch_offset == STATE.crouch_target then STATE.crouch_target = nil end
	end
end
