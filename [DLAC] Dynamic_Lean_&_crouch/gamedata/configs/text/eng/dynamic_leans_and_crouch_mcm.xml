<?xml version="1.0" encoding="windows-1251"?>

<string_table>
    <string id="ui_mcm_menu_dynamic_leans_and_crouch">
        <text>Dynamic Leans and Crouch</text>
    </string>
	<string id="dlac_lean_title">
        <text>Leaning</text>
    </string>
	<string id="dlac_crouch_title">
        <text>Crouching</text>
    </string>
	<string id="dlac_adjustment_keybind_title">
        <text>Adjustment Keybind</text>
    </string>
	<string id="dlac_adjustment_keybind_up_down_title">
        <text>Inc. Dec. Adjustment Keybind</text>
    </string>
	<string id="dlac_adjustment_keybind_up_down_title_desc">
        <text>Nudges the angle/height up and down. Only does anything in keybind mode.</text>
    </string>
	
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_mode">
        <text>Adjustment Mode</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_mode_desc">
        <text>How you control the dynamic lean - mouse movement or dedicated keys. Pick whichever feels right.</text>
    </string>
	<string id="dynamic_leans_and_crouch_lean_dlac_adjustment_mode_lst_mouse_move">
        <text>Mouse Movement</text>
    </string>
	<string id="dynamic_leans_and_crouch_lean_dlac_adjustment_mode_lst_keybind">
        <text>Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_mouse_sensitivity_factor">
        <text>Mouse Movement Sensitivity</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_mouse_sensitivity_factor_desc">
        <text>How much moving the mouse actually leans you. Middle of the slider is the normal amount, lower if it's too twitchy, higher if you want it snappier.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_keybind_sensitivity_factor">
        <text>Keybind Adjustment Sensitivity</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_keybind_sensitivity_factor_desc">
        <text>Same idea but for keybind mode instead of the mouse. Middle of the slider matches the mouse's normal feel.</text>
    </string>
	
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_use_lean_for_liz_inertia_factor">
        <text>Lean affects Liz Inertia Anim Power</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_use_lean_for_liz_inertia_factor_desc">
        <text>Scales the Liz Inertia lean animation with how far you're actually leaning instead of always full strength.</text>
    </string>
	
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_keybind">
        <text>Lean Adjustment Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_keybind_desc">
        <text>Hold this + move the mouse to adjust your lean. Without it held, nothing happens.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_keybind_left">
        <text>Left Adjustment Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_keybind_left_desc">
        <text>Hold with the adjustment key to lean further left.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_keybind_right">
        <text>Right Adjustment Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_adjustment_keybind_right_desc">
        <text>Hold with the adjustment key to lean further right.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_dynamically_switch_sides">
        <text>Dynamically Switch Sides</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_dynamically_switch_sides_desc">
        <text>Push a lean all the way and keep going - instead of just stopping, it carries you over into leaning the other way.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_lean_from_nothing">
        <text>Lean From Nothing</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_lean_dlac_lean_from_nothing_desc">
        <text>Start a lean straight from the mouse, no need to tap a lean key first. Direction follows wherever you move the mouse.</text>
    </string>
	
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_mode">
        <text>Adjustment Mode</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_mode_desc">
        <text>Same as the lean one - mouse or keybind, whatever you prefer for crouch height.</text>
    </string>
	<string id="dynamic_leans_and_crouch_crouch_dlac_adjustment_mode_lst_mouse_move">
        <text>Mouse Movement</text>
    </string>
	<string id="dynamic_leans_and_crouch_crouch_dlac_adjustment_mode_lst_keybind">
        <text>Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_mouse_sensitivity_factor">
        <text>Mouse Movement Sensitivity</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_mouse_sensitivity_factor_desc">
        <text>How much moving the mouse changes your crouch height. Default is the middle of the slider - go lower for finer control, higher if it feels sluggish.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_keybind_sensitivity_factor">
        <text>Keybind Adjustment Sensitivity</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_keybind_sensitivity_factor_desc">
        <text>Same idea but for keybind mode instead of the mouse. Middle of the slider matches the mouse's normal feel.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_keybind">
        <text>Crouch Adjustment Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_keybind_desc">
        <text>Hold this + move the mouse to adjust crouch height. Nothing happens without it held.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_keybind_up">
        <text>Up Adjustment Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_keybind_up_desc">
        <text>Hold with the adjustment key to rise up.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_keybind_down">
        <text>Down Adjustment Keybind</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_adjustment_keybind_down_desc">
        <text>Hold with the adjustment key to sink lower.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_dynamically_switch_stances">
        <text>Dynamically Switch Stances</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_dynamically_switch_stances_desc">
        <text>Crouch all the way down and keep pushing and you'll flow into prone instead of hitting a wall. Same going back up into standing.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_crouch_from_nothing">
        <text>Crouch From Nothing</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_crouch_from_nothing_desc">
        <text>Lets you crouch just by using the mouse, without pressing the crouch key first.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_stance_commit_factor">
        <text>Stance Commit Firmness</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_crouch_dlac_stance_commit_factor_desc">
        <text>How firm a push is needed at the top or bottom of your crouch range before it actually commits to standing or prone. Going prone is deliberately harder to trigger than standing back up. This slider scales both together, keeping that balance.</text>
    </string>

    <string id="dlac_general_title">
        <text>General</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_general_dlac_mod_enabled">
        <text>Enable Mod</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_general_dlac_mod_enabled_desc">
        <text>Master on/off switch. Turning it off stands you up straight and drops any lean first, so it's the safe way to disable it - do this before removing the mod too, otherwise you could get stuck mid-crouch with nothing left to fix it.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_general_dlac_sprint_removes_stance_and_lean">
        <text>Sprinting Removes Stance And Lean</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_general_dlac_sprint_removes_stance_and_lean_desc">
        <text>Trying to sprint out of a lean or crouch/prone will actually stand you up first instead of just refusing to run.</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_general_dlac_default_reset_timer">
        <text>Return-To-Normal Speed</text>
    </string>
	<string id="ui_mcm_dynamic_leans_and_crouch_general_dlac_default_reset_timer_desc">
        <text>How smoothly the regular crouch/lean keys settle back to normal after you use them. Turn it all the way down if you'd rather it just snap instantly like before.</text>
    </string>
</string_table>
